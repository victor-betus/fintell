# =============================================================================
# FINTELL — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values.
# All flags accept: true | false (case-insensitive)
# =============================================================================


# -----------------------------------------------------------------------------
# PREPROCESSING FLAGS
# Control which steps are applied when cleaning and preparing raw text data.
# These affect both ML and DL pipelines unless specified otherwise.
# -----------------------------------------------------------------------------

# Apply lemmatization during text cleaning (reduces words to their root form)
PREPROCESS_LEMMATIZE=false

# Remove stopwords (common words like "the", "is", etc.) during cleaning
PREPROCESS_STOPWORDS=false

# Apply SMOTE to balance classes in the training set (ML pipeline only)
PREPROCESS_SMOTE=false

# Apply TF-IDF vectorization after cleaning (ML pipeline only)
PREPROCESS_VECTORIZE=true


# -----------------------------------------------------------------------------
# GCS CACHE FLAGS
# Skip preprocessing and load already-processed data directly from GCS.
# Set to true to save time when data has already been preprocessed once.
# Set to false to rerun the full preprocessing pipeline from raw data.
# -----------------------------------------------------------------------------

# Load cached preprocessed data for the ML pipeline from GCS
SAVE_PREPROCESSED=false
LOAD_PREPROCESSED=false

# Load cached preprocessed data for the sentiment DL pipeline from GCS
LOAD_DL_PREPROCESSED=false

# Load cached preprocessed data for the topics DL pipeline from GCS
LOAD_TOPIC_DL_PREPROCESSED=false


# -----------------------------------------------------------------------------
# MODEL TARGET
# Defines where models and artifacts are saved to and loaded from.
# local  → use the local /models directory (no GCS needed)
# gcs    → use Google Cloud Storage (requires GCS_PROJECT_ID and GCS_BUCKET_NAME)
# -----------------------------------------------------------------------------

MODEL_TARGET=gcs


# -----------------------------------------------------------------------------
# GOOGLE CLOUD STORAGE
# Required when MODEL_TARGET=gcs.
# GCS_PROJECT_ID  → your GCP project ID (found in Google Cloud Console)
# GCS_BUCKET_NAME → the GCS bucket where data and models are stored
# -----------------------------------------------------------------------------

GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name


# -----------------------------------------------------------------------------
# MODEL SELECTION
# Choose which model architecture to train or load.
# -----------------------------------------------------------------------------

# ML model used for sentiment classification
# Options: svc | logistic_regression | random_forest | naive_bayes
MODEL_NAME=svc

# DL model architecture for the sentiment pipeline
# Options: lstm | gru | bigru | bilstm
MODEL_DL_NAME=bigru

# DL model architecture for the topics pipeline
# Options: lstm | gru | bigru | bilstm
MODEL_TOPIC_DL_NAME=bigru


# -----------------------------------------------------------------------------
# DEEP LEARNING HYPERPARAMETERS
# These control how sequences are prepared and how the model is built.
# -----------------------------------------------------------------------------

# Embedding strategy for the DL pipeline
# word2vec        → pretrained Word2Vec embeddings (input shape: MAXLEN x VECTOR_SIZE)
# keras_embedding → learned embedding layer inside the model (input shape: MAXLEN)
EMBEDDER_NAME=keras_embedding

# Maximum number of tokens kept per review after padding/truncation
MAXLEN=80

# Word embedding size (only used with word2vec embedder)
VECTOR_SIZE=60

# Subsample the dataset for fast local experiments (0 = use full dataset)
SAMPLE_SIZE=0

# Weight loss by inverse class frequency to handle class imbalance
USE_CLASS_WEIGHT=false

